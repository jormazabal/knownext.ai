{
  "name": "knownext-ai",
  "private": true,
  "version": "2.5.0",
  "description": "KnowNext.ai desktop product for Markdown project documentation.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "pnpm --filter @knownext/desktop dev",
    "tauri": "pnpm --filter @knownext/desktop exec tauri",
    "desktop": "pnpm --filter @knownext/desktop tauri:dev",
    "android:init": "pnpm --filter @knownext/desktop tauri:android:init",
    "android:dev": "pnpm --filter @knownext/desktop tauri:android:dev",
    "android:build": "pnpm --filter @knownext/desktop tauri:android:build",
    "android:build:debug": "node scripts/build-android-debug.mjs",
    "android:build:release": "node scripts/build-android-release.mjs",
    "android:run": "pnpm --filter @knownext/desktop tauri:android:run",
    "build": "pnpm --filter @knownext/desktop build",
    "bundle:check-clean": "node scripts/check-client-bundle-clean.mjs",
    "test": "pnpm --filter @knownext/desktop test",
    "rust:check": "cargo check --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "rust:test": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml --workspace && cargo check --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "version:check": "node scripts/check-version.mjs",
    "release:secrets:check": "node scripts/check-release-secrets.mjs",
    "release:check": "pnpm version:check && pnpm build && pnpm bundle:check-clean && pnpm test && pnpm rust:test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
