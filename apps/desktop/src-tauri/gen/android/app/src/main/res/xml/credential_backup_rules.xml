<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Tauri app_data_dir is the package root on Android. Keys are device-bound. -->
    <exclude domain="root" path="credentials.json" />
    <exclude domain="root" path="auth.json" />
    <exclude domain="root" path="state-recovery/" />
    <exclude domain="root" path="ai-results/" />
    <exclude domain="root" path="project-transfers/" />
    <exclude domain="root" path="document-templates/" />
    <exclude domain="root" path="document-templates-retired/" />
</full-backup-content>
