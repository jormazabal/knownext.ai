{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KnowNext.ai",
  "version": "3.0.1",
  "identifier": "ai.knownext.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "beforeBundleCommand": "node ../../scripts/check-installer-resources.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KnowNext.ai",
        "width": 1536,
        "height": 1024,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "style-src-attr": "'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: https: http: knownext-asset: asset:",
        "media-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost knownext-asset: http://knownext-asset.localhost asset: http://asset.localhost blob: data:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "style-src-attr": "'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: https: http: knownext-asset: asset:",
        "media-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost knownext-asset: http://knownext-asset.localhost asset: http://asset.localhost blob: data: http://127.0.0.1:1420 ws://127.0.0.1:1420 http://10.0.2.2:1420 ws://10.0.2.2:1420",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [],
    "resources": ["crates/knownext-docs/assets/fonts/OFL.txt"],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "signCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../../scripts/sign-windows.ps1 %1",
      "wix": {
        "template": "./windows/wix/per-user-main.wxs",
        "upgradeCode": "389ecb95-c3d2-5327-872c-5e9508c14b2a"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyQjNFQkRCNUY2NTE4OEUKUldTT0dHVmYyK3V6WW5pNjBXSDh4WlhUclhOaU0wejZIZlUwTndLU0x3NER4ejR3ZFBleWRIUEEK",
      "endpoints": [
        "https://github.com/jormazabal/knownext.ai/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
